{
  "ConnectionStrings": {
    "BooksDb": "Data Source=BooksDB"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "JwtSettings": {
    "Issuer": "Books.API",
    "Audience": "Books.Client",
    "Key": "BooksMicroservicesJwtSecurityKey12345",
    "AccessTokenExpirationInMinutes": 30,
    "RefreshTokenExpirationInDays": 7
  },
  "AllowedHosts": "*"
}